{
  "name": "jam-redesign",
  "productName": "Jam Redesign",
  "version": "0.1.0",
  "description": "A redesigned front end for Band Desktop",
  "author": "Martin Lipp",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:live": "node scripts/dev.mjs --live",
    "build": "electron-vite build",
    "start": "node scripts/dev.mjs --preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.web-tests.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:identity": "node scripts/check-identity.mjs",
    "export:clean": "node scripts/export.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:identity",
    "test:e2e": "electron-vite build && playwright test",
    "ui:check": "electron-vite build && node scripts/ui-check.mjs",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "fixtures:record": "node scripts/record-shapes.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.35",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.45.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "zod": "4.6.4",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "engines": {
    "node": ">=22.18"
  }
}
